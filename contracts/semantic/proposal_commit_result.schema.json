{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ecos.invalid/v1/proposal_commit_result.schema.json",
  "title": "proposal_commit_result",
  "type": "object",
  "properties": {
    "proposal_id": {
      "type": "string",
      "format": "uuid"
    },
    "proposal_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item_id": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "$ref": "https://contracts.ecos.invalid/v1/vocabulary.schema.json#/$defs/proposal_item"
          },
          "reason_code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
          },
          "committed_event_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "minItems": 0,
            "uniqueItems": false
          },
          "result_hash": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "item_id",
          "state",
          "reason_code",
          "committed_event_ids",
          "result_hash"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": false
    }
  },
  "required": [
    "proposal_id",
    "proposal_hash",
    "schema_version",
    "correlation_id",
    "items"
  ],
  "additionalProperties": false
}
