{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ecos.invalid/v1/proposal_item.schema.json",
  "title": "proposal_item",
  "type": "object",
  "properties": {
    "item_id": {
      "type": "string",
      "format": "uuid"
    },
    "depends_on_item_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "source_references": {
      "type": "array",
      "items": {
        "$ref": "https://contracts.ecos.invalid/v1/source_reference.schema.json"
      },
      "minItems": 1,
      "uniqueItems": false
    },
    "expected_record_versions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "record_type": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
          },
          "record_id": {
            "type": "string",
            "format": "uuid"
          },
          "record_version": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "record_type",
          "record_id",
          "record_version"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": false
    },
    "proposed_operations": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "operation": {
                "const": "task.transition"
              },
              "arguments": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "expected_version": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "target_state": {
                    "$ref": "https://contracts.ecos.invalid/v1/vocabulary.schema.json#/$defs/task_lifecycle"
                  },
                  "wait_reason": {
                    "$ref": "https://contracts.ecos.invalid/v1/vocabulary.schema.json#/$defs/task_wait_reason"
                  },
                  "reason_code": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "$ref": "https://contracts.ecos.invalid/v1/evidence.schema.json"
                    },
                    "minItems": 0,
                    "uniqueItems": false
                  }
                },
                "required": [
                  "task_id",
                  "expected_version",
                  "target_state",
                  "wait_reason",
                  "reason_code",
                  "evidence"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "operation",
              "arguments"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "operation": {
                "const": "task.evidence.attach"
              },
              "arguments": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "expected_version": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "evidence": {
                    "$ref": "https://contracts.ecos.invalid/v1/evidence.schema.json"
                  }
                },
                "required": [
                  "task_id",
                  "expected_version",
                  "evidence"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "operation",
              "arguments"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "operation": {
                "const": "fact.record"
              },
              "arguments": {
                "type": "object",
                "properties": {
                  "subject_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "statement": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 10000
                  },
                  "source_references": {
                    "type": "array",
                    "items": {
                      "$ref": "https://contracts.ecos.invalid/v1/source_reference.schema.json"
                    },
                    "minItems": 1,
                    "uniqueItems": false
                  },
                  "sensitivity": {
                    "$ref": "https://contracts.ecos.invalid/v1/vocabulary.schema.json#/$defs/sensitivity"
                  }
                },
                "required": [
                  "subject_id",
                  "statement",
                  "source_references",
                  "sensitivity"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "operation",
              "arguments"
            ],
            "additionalProperties": false
          }
        ]
      },
      "minItems": 1,
      "uniqueItems": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "https://contracts.ecos.invalid/v1/evidence.schema.json"
      },
      "minItems": 1,
      "uniqueItems": false
    },
    "confidence_basis_points": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        {
          "type": "null"
        }
      ]
    },
    "unresolved_ambiguity": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 10000
      },
      "minItems": 0,
      "uniqueItems": false
    }
  },
  "required": [
    "item_id",
    "depends_on_item_ids",
    "source_references",
    "expected_record_versions",
    "proposed_operations",
    "evidence",
    "confidence_basis_points",
    "unresolved_ambiguity"
  ],
  "additionalProperties": false
}
