{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ecos.invalid/v1/work_definition.schema.json",
  "title": "work_definition",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "record_version": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
    },
    "definition_version": {
      "type": "integer",
      "minimum": 1
    },
    "enabled": {
      "type": "boolean"
    },
    "fulfillment_kind": {
      "type": "string",
      "enum": [
        "single_stage",
        "staged"
      ]
    },
    "retry_policy_id": {
      "type": "string",
      "format": "uuid"
    }
  },
  "required": [
    "id",
    "schema_version",
    "created_at",
    "record_version",
    "name",
    "definition_version",
    "enabled",
    "fulfillment_kind",
    "retry_policy_id"
  ],
  "additionalProperties": false
}
