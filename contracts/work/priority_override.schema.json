{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ecos.invalid/v1/priority_override.schema.json",
  "title": "priority_override",
  "type": "object",
  "properties": {
    "value": {
      "type": "integer",
      "minimum": -100,
      "maximum": 100
    },
    "actor_id": {
      "type": "string",
      "format": "uuid"
    },
    "reason_code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "value",
    "actor_id",
    "reason_code",
    "created_at",
    "expires_at"
  ],
  "additionalProperties": false
}
