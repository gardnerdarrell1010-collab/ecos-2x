{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ecos.invalid/v1/approval_request.schema.json",
  "title": "approval_request",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "record_version": {
      "type": "integer",
      "minimum": 1
    },
    "task_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "subject_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
    },
    "subject_id": {
      "type": "string",
      "format": "uuid"
    },
    "subject_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "state": {
      "$ref": "https://contracts.ecos.invalid/v1/vocabulary.schema.json#/$defs/approval"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "schema_version",
    "created_at",
    "record_version",
    "task_id",
    "subject_type",
    "subject_id",
    "subject_hash",
    "state",
    "expires_at"
  ],
  "additionalProperties": false
}
