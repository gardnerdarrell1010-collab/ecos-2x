{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ecos.invalid/v1/task_dependency.schema.json",
  "title": "task_dependency",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "record_version": {
      "type": "integer",
      "minimum": 1
    },
    "task_id": {
      "type": "string",
      "format": "uuid"
    },
    "prerequisite_task_id": {
      "type": "string",
      "format": "uuid"
    },
    "satisfaction_rule": {
      "type": "string",
      "enum": [
        "completed",
        "approved_evidence"
      ]
    }
  },
  "required": [
    "id",
    "schema_version",
    "created_at",
    "record_version",
    "task_id",
    "prerequisite_task_id",
    "satisfaction_rule"
  ],
  "additionalProperties": false
}
