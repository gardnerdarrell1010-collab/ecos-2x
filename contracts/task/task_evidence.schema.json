{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ecos.invalid/v1/task_evidence.schema.json",
  "title": "task_evidence",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "task_id": {
      "type": "string",
      "format": "uuid"
    },
    "evidence": {
      "$ref": "https://contracts.ecos.invalid/v1/evidence.schema.json"
    }
  },
  "required": [
    "id",
    "schema_version",
    "created_at",
    "task_id",
    "evidence"
  ],
  "additionalProperties": false
}
