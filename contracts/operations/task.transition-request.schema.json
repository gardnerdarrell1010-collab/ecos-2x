{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ecos.invalid/v1/task.transition-request.schema.json",
  "title": "task.transition-request",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "context": {
      "$ref": "https://contracts.ecos.invalid/v1/request_context.schema.json"
    },
    "arguments": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "format": "uuid"
        },
        "expected_version": {
          "type": "integer",
          "minimum": 1
        },
        "target_state": {
          "$ref": "https://contracts.ecos.invalid/v1/vocabulary.schema.json#/$defs/task_lifecycle"
        },
        "wait_reason": {
          "$ref": "https://contracts.ecos.invalid/v1/vocabulary.schema.json#/$defs/task_wait_reason"
        },
        "reason_code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "https://contracts.ecos.invalid/v1/evidence.schema.json"
          },
          "minItems": 0,
          "uniqueItems": false
        }
      },
      "required": [
        "task_id",
        "expected_version",
        "target_state",
        "wait_reason",
        "reason_code",
        "evidence"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "context",
    "arguments"
  ],
  "additionalProperties": false
}
