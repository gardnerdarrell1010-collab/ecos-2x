{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ecos.invalid/v1/fence.schema.json",
  "title": "fence",
  "type": "object",
  "properties": {
    "occurrence_id": {
      "type": "string",
      "format": "uuid"
    },
    "stage_definition_id": {
      "type": "string",
      "format": "uuid"
    },
    "claim_id": {
      "type": "string",
      "format": "uuid"
    },
    "claim_version": {
      "type": "integer",
      "minimum": 1
    },
    "fence_token": {
      "type": "string",
      "format": "uuid"
    },
    "executor_instance_id": {
      "type": "string",
      "format": "uuid"
    }
  },
  "required": [
    "occurrence_id",
    "stage_definition_id",
    "claim_id",
    "claim_version",
    "fence_token",
    "executor_instance_id"
  ],
  "additionalProperties": false
}
