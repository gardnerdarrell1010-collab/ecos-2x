{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ecos.invalid/v1/approval.decide-request.schema.json",
  "title": "approval.decide-request",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "context": {
      "$ref": "https://contracts.ecos.invalid/v1/request_context.schema.json"
    },
    "arguments": {
      "type": "object",
      "properties": {
        "approval_request_id": {
          "type": "string",
          "format": "uuid"
        },
        "expected_version": {
          "type": "integer",
          "minimum": 1
        },
        "decision": {
          "type": "string",
          "enum": [
            "approved",
            "rejected",
            "changes_requested"
          ]
        },
        "subject_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reason_code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
        }
      },
      "required": [
        "approval_request_id",
        "expected_version",
        "decision",
        "subject_hash",
        "reason_code"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "context",
    "arguments"
  ],
  "additionalProperties": false
}
