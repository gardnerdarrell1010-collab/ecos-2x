{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ecos.invalid/v1/request_context.schema.json",
  "title": "request_context",
  "type": "object",
  "properties": {
    "principal_id": {
      "type": "string",
      "format": "uuid"
    },
    "executor_instance_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "causation_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    }
  },
  "required": [
    "principal_id",
    "executor_instance_id",
    "correlation_id",
    "causation_id",
    "idempotency_key"
  ],
  "additionalProperties": false
}
