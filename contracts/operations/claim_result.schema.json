{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ecos.invalid/v1/claim_result.schema.json",
  "title": "claim_result",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "claim": {
      "anyOf": [
        {
          "$ref": "https://contracts.ecos.invalid/v1/work_claim.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "execution_run": {
      "anyOf": [
        {
          "$ref": "https://contracts.ecos.invalid/v1/execution_run.schema.json"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "correlation_id",
    "claim",
    "execution_run"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "claim": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "execution_run": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "execution_run": {
            "type": "object"
          }
        }
      }
    }
  ]
}
