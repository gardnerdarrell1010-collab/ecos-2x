{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ecos.invalid/v1/work.claim-request.schema.json",
  "title": "work.claim-request",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "context": {
      "$ref": "https://contracts.ecos.invalid/v1/request_context.schema.json"
    },
    "arguments": {
      "type": "object",
      "properties": {
        "executor_instance_id": {
          "type": "string",
          "format": "uuid"
        },
        "lease_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        }
      },
      "required": [
        "executor_instance_id",
        "lease_seconds"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "context",
    "arguments"
  ],
  "additionalProperties": false
}
