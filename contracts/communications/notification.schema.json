{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ecos.invalid/v1/notification.schema.json",
  "title": "notification",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "record_version": {
      "type": "integer",
      "minimum": 1
    },
    "business_reason_code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
    },
    "subject_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
    },
    "subject_id": {
      "type": "string",
      "format": "uuid"
    },
    "content_artifact_uri": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "policy_version": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "id",
    "schema_version",
    "created_at",
    "record_version",
    "business_reason_code",
    "subject_type",
    "subject_id",
    "content_artifact_uri",
    "content_hash",
    "policy_version"
  ],
  "additionalProperties": false
}
