{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ecos.invalid/v1/delivery_attempt.schema.json",
  "title": "delivery_attempt",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "delivery_id": {
      "type": "string",
      "format": "uuid"
    },
    "provider_attempt_id": {
      "type": "string",
      "format": "uuid"
    },
    "provider_message_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "provider_status_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "schema_version",
    "created_at",
    "delivery_id",
    "provider_attempt_id",
    "provider_message_id",
    "evidence_hash",
    "provider_status_at"
  ],
  "additionalProperties": false
}
