{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ecos.invalid/v1/stage_capability_requirement.schema.json",
  "title": "stage_capability_requirement",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "record_version": {
      "type": "integer",
      "minimum": 1
    },
    "stage_definition_id": {
      "type": "string",
      "format": "uuid"
    },
    "capability_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
    },
    "minimum_version": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "id",
    "schema_version",
    "created_at",
    "record_version",
    "stage_definition_id",
    "capability_name",
    "minimum_version"
  ],
  "additionalProperties": false
}
