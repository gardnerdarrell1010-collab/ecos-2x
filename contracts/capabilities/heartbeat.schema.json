{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ecos.invalid/v1/heartbeat.schema.json",
  "title": "heartbeat",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "executor_instance_id": {
      "type": "string",
      "format": "uuid"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "received_at": {
      "type": "string",
      "format": "date-time"
    },
    "valid_until": {
      "type": "string",
      "format": "date-time"
    },
    "availability": {
      "$ref": "https://contracts.ecos.invalid/v1/vocabulary.schema.json#/$defs/availability"
    },
    "evidence_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "id",
    "schema_version",
    "created_at",
    "executor_instance_id",
    "observed_at",
    "received_at",
    "valid_until",
    "availability",
    "evidence_hash"
  ],
  "additionalProperties": false
}
