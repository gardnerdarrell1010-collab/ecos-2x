{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ecos.invalid/v1/executor.schema.json",
  "title": "executor",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "record_version": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
    },
    "surface": {
      "$ref": "https://contracts.ecos.invalid/v1/vocabulary.schema.json#/$defs/execution_surface"
    },
    "enabled": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "schema_version",
    "created_at",
    "record_version",
    "name",
    "surface",
    "enabled"
  ],
  "additionalProperties": false
}
