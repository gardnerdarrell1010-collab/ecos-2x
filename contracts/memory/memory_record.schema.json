{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ecos.invalid/v1/memory_record.schema.json",
  "title": "memory_record",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "record_version": {
      "type": "integer",
      "minimum": 1
    },
    "business_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "scope_id": {
      "type": "string",
      "format": "uuid"
    },
    "memory_kind": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
    },
    "active_head_version_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "schema_version",
    "created_at",
    "record_version",
    "business_id",
    "scope_id",
    "memory_kind",
    "active_head_version_id"
  ],
  "additionalProperties": false
}
